// Compute stage: raymarches the scene's flat plane primitives for EVERY
// pixel in parallel (one work item per pixel) and writes one packed RGBA8
// uint per pixel into the shared pixel buffer (SSBO, binding 0). The
// display stage (RaymarcherDisplay.fs) then blits that buffer to the
// screen, so the fragment pipeline only performs a 1:1 buffer read.
//
// Per-plane uniform data lives in PlaneData (3 vec4 per plane):
//   [0] origin.xyz, size
//   [1] normal.xyz, textureIndex
//   [2] uvScale.xy, 0, 0
// See PlanePrimitive.WriteInto for the C# side.
//
// NOTES:
//   - #version 430 is required for compute shaders (dispatch, SSBOs,
//     layout(local_size...)) and must stay the first line: Resource.LoadShader
//     expands the #include directives IN PLACE below it (included files must
//     never carry a #version of their own).
//   - PlaneTex is sampled from texture unit 0: the C# side binds the texture
//     there before dispatching and sets the sampler uniform to 0.
//     Raylib.SetShaderValueTexture must NOT be used for the compute stage -
//     it defers the real glBindTexture to the batch draw, which happens
//     AFTER the dispatch.
#version 430

#include "RaymarcherHelpers.inc"

#define MAX_PLANES 8

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

uniform vec2  Resolution;            // framebuffer size in pixels
uniform mat4  CamToWorld;            // camera space (y up, -z forward) -> world
uniform float Focal;                 // 1 / tan(fovY * 0.5), precomputed in C#
uniform int   PlaneCount;
uniform vec4  PlaneData[MAX_PLANES * 3];
uniform sampler2D PlaneTex;          // bound to texture unit 0 by the C# side

// One packed RGBA8 uint per screen pixel, shared with the display stage
// (std430 uint array: 4-byte stride, no padding).
layout(std430, binding = 0) buffer Pixels
{
    uint data[];
} pixelBuf;

// Analytic ray/plane intersection. Returns distance t (or -1 on miss) and
// the hit point's UV in *tile space* (already tiled by the plane's UvScale).
float IntersectPlane(vec3 ro, vec3 rd, int i, out vec2 uv)
{
    vec4 a = PlaneData[i * 3 + 0];
    vec4 b = PlaneData[i * 3 + 1];
    vec4 c = PlaneData[i * 3 + 2];

    vec3 origin = a.xyz;
    float size  = a.w;
    vec3 normal = normalize(b.xyz);

    float denom = dot(rd, normal);
    if (abs(denom) < 1e-6) return -1.0;   // (nearly) parallel to the plane

    float t = dot(origin - ro, normal) / denom;
    if (t <= 0.0) return -1.0;            // behind the camera

    vec3 hit = ro + rd * t;

    // Orthonormal basis for the plane's local frame, so UVs are defined in
    // plane space - this keeps tiling consistent even when the engine bends
    // space around the plane. For a +Y normal this gives xAxis = +Z, yAxis = +X.
    vec3 refAxis = (abs(normal.y) > 0.99) ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 xAxis = normalize(cross(refAxis, normal));
    vec3 yAxis = cross(normal, xAxis);

    vec3 rel = hit - origin;
    vec2 local = vec2(dot(rel, xAxis), dot(rel, yAxis));

    if (size > 0.0 && (abs(local.x) > size || abs(local.y) > size))
        return -1.0;                                  // finite plane, hit off the edge

    uv = local * c.xy;                                // <- UV tiling
    return t;
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);

    // The dispatch grid is rounded up to whole workgroups; ignore the tail.
    if (pix.x >= int(Resolution.x) || pix.y >= int(Resolution.y)) return;

    // Pixel center in normalized device coords (y up, -1..1, x aspect-corrected).
    vec2 ndc = (2.0 * gl_GlobalInvocationID.xy - Resolution) / Resolution.y;

    // Pixel ray in camera space, then world space.
    vec3 dirCam = normalize(vec3(ndc, -Focal));
    vec3 rd = normalize((CamToWorld * vec4(dirCam, 0.0)).xyz);
    vec3 ro = (CamToWorld * vec4(0.0, 0.0, 0.0, 1.0)).xyz;

    // Closest plane hit. NOTE: uv is only latched when t improves - the old
    // fragment shader passed a single out-param into every call, so a farther
    // plane hit later in the loop would clobber the closest hit's UV.
    float t = -1.0;
    vec2 uv = vec2(0.0);
    for (int i = 0; i < MAX_PLANES; i++)
    {
        if (i >= PlaneCount) break;
        vec2 candUv;
        float th = IntersectPlane(ro, rd, i, candUv);
        if (th > 0.0 && (t < 0.0 || th < t)) { t = th; uv = candUv; }
    }

    vec3 color;
    if (t > 0.0)
    {
        // Tiled texture sample (sampler wrap = REPEAT, so fract() is implicit).
        color = texture(PlaneTex, uv).rgb;

        // Gentle exponential distance fog toward the horizon.
        vec3 fogColor = SkyColor(normalize(vec3(rd.x, 0.0, rd.z)));
        float fog = 1.0 - exp(-0.010 * t);
        color = mix(color, fogColor, fog);
    }
    else
    {
        color = SkyColor(rd);
    }

    // Pack RGBA8 into one uint (alpha always opaque).
    // NOTE: the local name must not be 'packed' - it is a reserved GLSL keyword.
    uint packedPx = (uint(color.r * 255.0 + 0.5))
                | (uint(color.g * 255.0 + 0.5) << 8)
                | (uint(color.b * 255.0 + 0.5) << 16)
                | 0xFF000000u;

    pixelBuf.data[pix.x + pix.y * int(Resolution.x)] = packedPx;
}
