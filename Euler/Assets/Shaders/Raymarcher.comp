// Compute stage: raymarches the scene for EVERY pixel of the INTERNAL
// resolution in parallel (one work item per pixel) and writes 3 uints per
// pixel into the shared output buffer (SSBO, binding 0):
//   [0] packed RGBA8 color
//   [1] float bitcast of the hit's total path length (DIST_SKY on a miss)
//   [2] 3x8-bit shaded world normal | 8-bit family id (top byte)
// The display stage (RaymarcherDisplay.fs) then EDGE-AWARE UPSCALES that
// buffer to the full window resolution (2x2 neighborhood weighted by the
// distance/normal/family signals) - see that file for the weighting.
//
// This file is the raymarcher's DRIVER. It owns the per-pixel ray, the
// camera/ray uniforms, the output buffer and the overall flow:
//
//     pixel -> Ray -> IntersectScene (closest hit) -> shade -> pack -> SSBO
//
// Scene pieces are NOT in this file - they are included, self-contained,
// and follow the contract documented in Raymarcher/Shapes/Plane.inc:
//
//     #include "Raymarcher/Shapes/Plane.inc"    plane shape family
//     #include "Raymarcher/Shapes/Terrain.inc"  infinite FBM heightfield terrain
//     #include "Raymarcher/Shapes/Wormhole.inc" traversable wormhole: 4D throat space
//     #include "Raymarcher/Sky.inc"             sky / horizon atmosphere
//
//     Raymarcher/Lighting.inc is included LATE (just before main, after the
//     driver's trace machinery): its ray-traced passes (hard shadows today,
//     reflections / GI reserved) trace SECONDARY rays through the SAME scene
//     flow as the primary ray (TraceSheetRay -> WhMarch), so every ray sees
//     the exact same bent (wormhole) space. See that file for the pass model.
//
// ADDING A FEATURE (the include contract):
//   - Shape family: add Raymarcher/Shapes/<Name>.inc declaring its family ID
//     (const int Family<Name> = N; - next free number), its data, uniforms,
//     Intersect<Name>(...) and Shade<Name>(...) (ALBEDO only - lighting is
//     the lighting system's job), then extend IntersectScene() to race it
//     against the other families and the shading dispatch in main().
//   - Ray-traced lighting passes (reflections, GI, ...): add a pass in
//     Raymarcher/Lighting.inc - a secondary-ray trace through TraceSheetRay()
//     plus its contribution term in ApplyLighting() - and set its bit in the
//     C# LightPasses enum. The primary ray path does not change.
//   - Upscaler guidance: IntersectScene() latches the winner's world-space
//     shading normal AND the world-space hit position too (each family
//     latches its normal and pos in the same block that latches its t/uv - a
//     farther hit must never clobber it); main() packs normal + family id +
//     path length into the SSBO stride for the display stage's edge-aware
//     2x2 upscaler. The pos latch feeds the lighting system (shadow ray
//     origins) - it is the hit's true 3D position on its sheet, even for a
//     wormhole-mediated hit (where t is the TOTAL 4D-bent path length and
//     Origin + Dir * t is NOT the hit point).
//   - 4D objects / non-Euclidean geometry: DONE (wormhole) - see the
//     wormhole branch of main(): a 4D-authoritative camera (WormholeCam), a
//     per-pixel gate (does this ray enter the mouth?), an analytic pre-test
//     for objects in front of the mouth, a 4D throat march (WhMarch) and a
//     handoff to the exact analytic path on the flat sheets.
//   - Atmosphere/background: extend Raymarcher/Sky.inc.
//
// NOTES:
//   - #version 430 is required for compute shaders (dispatch, SSBOs,
//     layout(local_size...)) and must stay the first line: Resource.LoadShader
//     expands the #include directives IN PLACE below it (included files must
//     never carry a #version of their own).
//   - PlaneTex is sampled from texture unit 0: the C# side binds the texture
//     there before dispatching and sets the sampler uniform to 0.
//     Raylib.SetShaderValueTexture must NOT be used for the compute stage -
//     it defers the real glBindTexture to the batch draw, which happens
//     AFTER the dispatch.
#version 430

#include "Raymarcher/Shapes/Plane.inc"
#include "Raymarcher/Shapes/Terrain.inc"
#include "Raymarcher/Shapes/Wormhole.inc"
#include "Raymarcher/Sky.inc"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// ---------------------------------------------------------------------------
// Driver state
// ---------------------------------------------------------------------------

// The per-pixel ray, shared by every shape/atmosphere include. Kept as a
// struct so future includes (reflections, 4D rays) work with one stable type.
struct Ray
{
    vec3 Origin;    // world space
    vec3 Dir;       // world space, normalized
};

uniform vec2  Resolution;            // framebuffer size in pixels
uniform mat4  CamToWorld;            // camera space (y up, -z forward) -> world
uniform float Focal;                 // 1 / tan(fovY * 0.5), precomputed in C#

// 3 uints per INTERNAL-resolution pixel, shared with the display stage
// (std430 uint array: 4-byte stride, no padding). Layout (see
// RaymarcherDisplay.fs for how the upscaler consumes it):
//   [0] packed RGBA8 color
//   [1] float bitcast of the hit's total path length (DIST_SKY on a miss)
//   [2] 3x8-bit shaded world normal ([-1,1] -> [0,255]) | 8-bit family id
//       in the top byte (0 = sky, 1 = plane, 2 = terrain; = family + 1)
layout(std430, binding = 0) buffer Pixels
{
    uint data[];
} pixelBuf;

// Distance sentinel for a sky/miss pixel: a finite float (NOT +inf) so the
// display stage's relative-depth comparison |d - dRef| / min(d, dRef) stays
// total-ordered - a miss against any real hit gives a huge delta (rejected),
// a miss against a miss gives 0 (identical).
const float DIST_SKY = 1e30;

// ---------------------------------------------------------------------------
// Ray generation
// ---------------------------------------------------------------------------

// World-space primary ray through the center of the given pixel.
Ray MakePixelRay(vec2 pixel)
{
    // Pixel center in normalized device coords (y up, -1..1, x aspect-corrected).
    vec2 ndc = (2.0 * pixel - Resolution) / Resolution.y;

    // Pixel ray in camera space, then world space.
    vec3 dirCam = normalize(vec3(ndc, -Focal));
    return Ray(
        (CamToWorld * vec4(0.0, 0.0, 0.0, 1.0)).xyz,
        normalize((CamToWorld * vec4(dirCam, 0.0)).xyz));
}

// ---------------------------------------------------------------------------
// Scene intersection: closest hit across ALL shape families
// ---------------------------------------------------------------------------

// Races every included shape family and keeps the closest hit. Returns true
// on hit, with the hit distance t, the winner's family-space uv, the
// winner's world-space shading normal, the winner's world-space hit position
// and the winner's family ID (Family<Name>, declared in each shape's .inc)
// latched.
//
// Each family block must follow the plane pattern below: an
// Intersect<Family>() that returns -1 on miss and only latches its uv AND
// normal when t improves (a farther hit later in the block must never
// clobber the closest hit's uv or normal). The normal is computed only in
// the block that actually WINS the race so far (terrain's finite-difference
// normal is the expensive one) - it feeds the display stage's edge-aware
// upscaler, which needs one consistent normal per winning ray.
// *universe is the side of the wormhole the ray is travelling on (+1 upper,
// -1 lower): the terrain exists in BOTH universes (same heightfield), the
// flat planes exist only in the upper one, so the lower-universe pass skips
// the plane family.
bool IntersectScene(Ray ray, int universe,
                    out vec2 uv, out float t, out int family, out vec3 nrm, out vec3 pos)
{
    t      = -1.0;
    uv     = vec2(0.0);
    family = -1;
    nrm    = vec3(0.0);
    pos    = ray.Origin;

    // --- Plane family (upper universe only) ---
    if (universe >= 0)
    {
        for (int i = 0; i < MAX_PLANES; i++)
        {
            if (i >= PlaneCount) break;
            vec2 candUv;
            float th = IntersectPlane(ray.Origin, ray.Dir, i, candUv);
            if (th > 0.0 && (t < 0.0 || th < t))
            {
                t = th; uv = candUv; family = FamilyPlane;
                nrm = normalize(PlaneData[i * 3 + 1].xyz);
                pos = ray.Origin + ray.Dir * th;
            }
        }
    }

    // --- Terrain family ---
    if (TerrainEnabled > 0)
    {
        vec2 candUv;
        float th = IntersectTerrain(ray.Origin, ray.Dir, candUv);
        if (th > 0.0 && (t < 0.0 || th < t))
        {
            t = th; uv = candUv; family = FamilyTerrain;
            // Finite-difference normal at the hit (world xz; the LOD octave
            // falloff uses the path length th, exactly as ShadeTerrain did
            // before the normal moved here).
            nrm = TerrainNormal(candUv + TerrainData[0].xz, th);
            pos = ray.Origin + ray.Dir * th;
        }
    }

    return t > 0.0;
}

// Shadow-ray variant: closest hit of ANY geometry, with the hit distance
// only (no uv / family / normal latching - a shadow ray needs to know IF
// something occludes the light, not what it hit). The terrain's sub-surface
// early-out is relaxed for these rays (see MarchTerrain in Terrain.inc):
// a crossing of the point's OWN local surface within SHADOW_HIT_TOL of the
// origin (the acne case - on a slope steeper than the sun's elevation the
// ray is inside the solid near the origin) is marched THROUGH, and the next
// crossing - the real occluder - is what is reported. Everything else - the
// family race, the wormhole flow, the step/bisection - is identical to the
// primary trace.
bool IntersectSceneShadow(Ray ray, int universe, out float t)
{
    t = -1.0;

    if (universe >= 0)
    {
        for (int i = 0; i < MAX_PLANES; i++)
        {
            if (i >= PlaneCount) break;
            vec2 candUv;
            float th = IntersectPlane(ray.Origin, ray.Dir, i, candUv);
            if (th > 0.0 && (t < 0.0 || th < t)) t = th;
        }
    }

    if (TerrainEnabled > 0)
    {
        float th = IntersectTerrainShadow(ray.Origin, ray.Dir);
        if (th > 0.0 && (t < 0.0 || th < t)) t = th;
    }

    return t > 0.0;
}

// ---------------------------------------------------------------------------
// Wormhole: 4D throat march (the driver's non-Euclidean flow)
// ---------------------------------------------------------------------------

// Marches a 4D ray along the wormhole hypersurface (Wormhole.inc owns the
// space geometry). See that file for the key property that makes this loop
// scene-SDF-free: a ray on the throat cannot reach a sheet object before it
// leaves the curved region, so stepping by the space step limit alone is
// exact, and the handoff below runs the exact analytic path from the exit.
//
// Returns true on a scene hit (*t includes the 4D path length so far, so
// fog matches what the light actually travelled, and *pos is the hit's true
// 3D position on the exit sheet). On a miss, latches *skyDir (final 3D
// direction) and *universe (the sheet the ray ended on). `shadow` selects
// the hit-distance-only intersection (IntersectSceneShadow) for secondary
// rays: same march, same handoff, cheaper leaf.
bool WhMarch(vec4 ro4, vec4 rd4, bool shadow,
             out vec2 uv, out float t, out int family, out vec3 nrm, out vec3 pos,
             out int universe, out vec3 skyDir)
{
    vec4  p4      = ro4;
    vec4  d4      = rd4;
    float pathLen = 0.0;
    float rMaj2   = WhRmaj() * WhRmaj();

    // The curved region is the mouth ball (|xyz| < rMaj). A sheet camera
    // starts OUTSIDE it: the first (large, flat-sheet) steps approach the
    // mouth, and the march may only hand off to the exact 3D path once the
    // ray has ENTERED the ball and LEFT it again - handing off before entry
    // would treat the throat as flat space (the mouth disappears).
    bool inBall = dot(ro4.xyz, ro4.xyz) < rMaj2;
    pos = WhCenter() + ro4.xyz;

    for (int i = 0; i < WH_MAX_STEPS; i++)
    {
        float d = SpaceStepLimit(p4);
        p4 += d4 * d;
        pathLen += d;
        SpaceNormalize(p4, d4);   // the non-Euclidean step: re-project onto space

        bool nowInBall = dot(p4.xyz, p4.xyz) < rMaj2;
        if (inBall && !nowInBall)
        {
            // The ray left the curved region onto a flat sheet (the snap
            // put it at w = +-Rmin and zeroed d4.w): the rest of its path
            // is an exact straight 3D ray.
            universe = (p4.w >= 0.0) ? 1 : -1;
            vec3 pos3 = WhCenter() + p4.xyz;
            vec3 dir3 = d4.xyz;                  // unit: d4.w = 0 on the sheet
            skyDir = dir3;
            if (shadow)
            {
                float th;
                if (IntersectSceneShadow(Ray(pos3, dir3), universe, th))
                {
                    t = pathLen + th; pos = pos3 + dir3 * th;
                    return true;
                }
                return false;                    // sky, tinted by *universe
            }
            vec2  tu;
            float th;
            int   tf;
            vec3  tn, tp;
            if (IntersectScene(Ray(pos3, dir3), universe, tu, th, tf, tn, tp))
            {
                uv = tu; t = pathLen + th; family = tf; nrm = tn; pos = tp;
                return true;
            }
            return false;                        // sky, tinted by *universe
        }
        inBall = nowInBall;
    }

    // Step budget exhausted (a ray looping deep on the throat): hand over to
    // the exact 3D path from the current point. A thin band of pixels; the
    // 3D projection is a reasonable stand-in there.
    universe = (p4.w >= 0.0) ? 1 : -1;
    vec3 pos3 = WhCenter() + p4.xyz;
    float l3  = length(d4.xyz);
    if (l3 > 1e-4)
    {
        vec3 dir3 = d4.xyz / l3;
        skyDir = dir3;
        if (shadow)
        {
            float th;
            if (IntersectSceneShadow(Ray(pos3, dir3), universe, th))
            {
                t = pathLen + th; pos = pos3 + dir3 * th;
                return true;
            }
            return false;
        }
        vec2  tu;
        float th;
        int   tf;
        vec3  tn, tp;
        if (IntersectScene(Ray(pos3, dir3), universe, tu, th, tf, tn, tp))
        {
            uv = tu; t = pathLen + th; family = tf; nrm = tn; pos = tp;
            return true;
        }
        return false;
    }
    else
    {
        // Looking straight along the w axis (no 3D projection at all):
        // pure sky.
        skyDir = vec3(0.0, 1.0, 0.0);
    }
    return false;
}

// ---------------------------------------------------------------------------
// Unified scene trace: THE non-Euclidean flow for any ray that starts in the
// wormhole space (a sheet origin or the curved region)
// ---------------------------------------------------------------------------

// Traces a ray that starts ON a flat sheet or in the curved region of the
// wormhole space, following the exact flow the primary ray uses:
//
//     sheet origin, ray never enters the mouth   -> exact straight 3D path,
//     sheet origin, object in front of the mouth -> exact 3D hit (pre-test),
//     else (entry, or origin in the curved region)-> 4D throat march
//                                                   (WhMarch) with the exact
//                                                   3D handoff at the exit
//                                                   sheet.
//
// This is THE tracer for SECONDARY rays too (the lighting system's shadow
// rays today; reflections / GI rays in the future): every ray sees the same
// bent space, so a shadow ray aimed at the sun can travel through the throat
// and be occluded by geometry on the OTHER sheet. `shadow` selects the
// hit-distance-only intersection (no uv/normal/family latching).
//
// `universe` is the sheet the ray starts on (+1 upper, -1 lower); on a
// wormhole-mediated miss *universeOut holds the sheet the ray ended on (the
// sky tint), and *t on a hit is the TOTAL path length (4D throat + 3D
// handoff) - *pos is the hit's true 3D position on its sheet.
bool TraceSheetRay(vec4 ro4, vec4 rd4, bool shadow, int universe,
                   out vec2 uv, out float t, out int family, out vec3 nrm, out vec3 pos,
                   out int universeOut, out vec3 skyDir)
{
    uv     = vec2(0.0);
    t      = 0.0;
    family = -1;
    nrm    = vec3(0.0);
    pos    = WhCenter() + ro4.xyz;
    universeOut = universe;
    skyDir   = vec3(0.0, 1.0, 0.0);

    if (WhOnSheet(ro4))
    {
        vec3 f3 = rd4.xyz;
        float l3 = length(f3);
        if (l3 > 1e-4)
        {
            vec3 ro3 = WhCenter() + ro4.xyz;
            vec3 rd3 = f3 / l3;
            skyDir = rd3;

            // Exact distance along rd3 to the mouth ball (or -1 when the ray
            // never enters it).
            float b    = dot(ro4.xyz, rd3);
            float c2   = dot(ro4.xyz, ro4.xyz) - WhRmaj() * WhRmaj();
            float disc = b * b - c2;
            float tEnter = (b < 0.0 && disc > 0.0) ? -b - sqrt(disc) : -1.0;

            if (tEnter < 0.0)
            {
                // Never enters the mouth: the straight 3D path is exact.
                if (shadow)
                {
                    float th;
                    return IntersectSceneShadow(Ray(ro3, rd3), universe, th);
                }
                return IntersectScene(Ray(ro3, rd3), universe, uv, t, family, nrm, pos);
            }

            // Pre-test: an object in front of the mouth is hit BEFORE the
            // ray reaches the curved region - the 4D path cannot change
            // that, so take the exact 3D hit and skip the march. A 3D hit
            // inside/behind the ball is meaningless (the 4D path decides) -
            // the march takes over and its handoff re-runs the exact path
            // from the exit sheet.
            if (shadow)
            {
                float th;
                if (IntersectSceneShadow(Ray(ro3, rd3), universe, th) && th < tEnter)
                {
                    t = th; pos = ro3 + rd3 * th;
                    return true;
                }
                return WhMarch(ro4, rd4, true, uv, t, family, nrm, pos, universeOut, skyDir);
            }

            vec2  puv;
            float pt;
            int   pf;
            vec3  pn, pp;
            if (IntersectScene(Ray(ro3, rd3), universe, puv, pt, pf, pn, pp) && pt < tEnter)
            {
                uv = puv; t = pt; family = pf; nrm = pn; pos = pp;
                return true;
            }
            return WhMarch(ro4, rd4, false, uv, t, family, nrm, pos, universeOut, skyDir);
        }
        // Looking straight along w (no 3D projection): the ray stays in the
        // curved region; march it.
        return WhMarch(ro4, rd4, shadow, uv, t, family, nrm, pos, universeOut, skyDir);
    }

    // Origin in the curved region (inside the mouth ball): the ray lives in
    // 4D until it reaches a sheet.
    return WhMarch(ro4, rd4, shadow, uv, t, family, nrm, pos, universeOut, skyDir);
}

// ---------------------------------------------------------------------------
// Shading helpers
// ---------------------------------------------------------------------------

// Gentle exponential distance fog toward the horizon (fog color from
// Sky.inc, fogged direction kept horizontal so the gradient stays stable,
// universe tint from Sky.inc so the lower universe fogs warm).
vec3 ApplyFog(vec3 color, float dist, vec3 dir, int universe)
{
    vec3  fd = vec3(dir.x, 0.0, dir.z);
    float fl = length(fd);
    fd = (fl > 1e-5) ? fd / fl : vec3(1.0, 0.0, 0.0);   // guard vertical rays
    vec3 fogColor = SkyColor(fd) * UniverseTint(universe);
    float fog = 1.0 - exp(-0.010 * dist);
    return mix(color, fogColor, fog);
}

// ---------------------------------------------------------------------------
// Ray-traced lighting (included LATE on purpose: its passes trace secondary
// rays through the trace machinery above - TraceSheetRay / WhMarch / the
// IntersectScene family - so it must come after those definitions)
// ---------------------------------------------------------------------------

#include "Raymarcher/Lighting.inc"

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);

    // The dispatch grid is rounded up to whole workgroups; ignore the tail.
    if (pix.x >= int(Resolution.x) || pix.y >= int(Resolution.y)) return;

    // Closest scene hit (uv, family, nrm and hitPos belong to the winning
    // family). t is the TOTAL path length of the ray (straight or 4D-bent)
    // so fog matches what the light actually travelled; skyDir is the final
    // ray direction; universe is the wormhole sheet the ray ends on (+1
    // upper, -1 lower) - it tints the sky and the fog. nrm is the winner's
    // world-space shading normal (the zero vector = no hit, packed as the
    // sky marker for the upscaler); hitPos is the hit's true 3D position on
    // its sheet (feeds the lighting system's secondary rays).
    vec2 uv = vec2(0.0);
    float t = 0.0;
    int family = -1;
    vec3 nrm = vec3(0.0);
    vec3 hitPos = vec3(0.0);
    vec3 skyDir = vec3(0.0, 1.0, 0.0);
    int universe = 1;
    bool hit = false;

    if (WormholeEnabled > 0)
    {
        // --------------------------------------------------------------
        // 4D wormhole pass. The camera is 4D-authoritative (WormholeCam:
        // columns Forward/Left/Up/Pos in wormhole-local space), so the
        // primary ray is generated in 4D exactly like the 3D MakePixelRay
        // (same ndc, same Focal): central pixel looks along Forward, the
        // screen plane is spanned by -Left (right) and Up.
        //
        // Per-pixel flow:
        //   camera on a sheet + ray never enters the mouth
        //       -> exact straight 3D path (the space is flat there),
        //   camera on a sheet + ray enters the mouth
        //       -> analytic pre-test for objects IN FRONT of the mouth
        //          (hit before entry: render it, skip the march),
        //       -> else WhMarch: 4D throat march, handoff to the exact
        //          3D path on the exit sheet,
        //   camera on the throat (inside the mouth)
        //       -> WhMarch for every ray.
        // --------------------------------------------------------------
        vec2 ndc = (2.0 * vec2(pix) - Resolution) / Resolution.y;
        vec4 ro4 = WormholeCam[3];
        vec4 rd4 = normalize(WormholeCam * vec4(Focal, -ndc.x, ndc.y, 0.0));

        universe = (ro4.w >= 0.0) ? 1 : -1;

        // 4D ray generation + the full non-Euclidean flow (sheet gate,
        // mouth-entry analytic pre-test, throat march, sheet handoff) live
        // in TraceSheetRay - the SAME tracer the lighting system's
        // secondary rays use, so primary and shadow rays bend identically.
        hit = TraceSheetRay(ro4, rd4, false, universe,
                            uv, t, family, nrm, hitPos, universe, skyDir);
    }
    else
    {
        Ray ray = MakePixelRay(vec2(pix));
        skyDir = ray.Dir;
        hit = IntersectScene(ray, universe, uv, t, family, nrm, hitPos);
    }

    vec3 color;
    if (hit)
    {
        // Dispatch to the material of the family that won the race (each
        // shape's .inc declares its own shade function returning the
        // ALBEDO; lighting is the lighting system's job - extend the
        // dispatch when adding a family).
        vec3 albedo = (family == FamilyTerrain)
                      ? ShadeTerrain(uv)
                      : ShadePlane(uv);

        // Ray-traced lighting: ambient + sun diffuse with the enabled
        // passes (hard shadows today; reflections / GI reserved - see
        // Raymarcher/Lighting.inc).
        color = ApplyLighting(albedo, skyDir, hitPos, nrm, universe);

        // Distance fog (universe-tinted, see Sky.inc).
        color = ApplyFog(color, t, skyDir, universe);
    }
    else
    {
        // Background: sky gradient, universe-tinted.
        color = SkyColor(skyDir) * UniverseTint(universe);
    }

    // ------------------------------------------------------------
    // Pack the pixel into the 3-uint stride the display stage expects
    // (layout at the pixelBuf declaration above):
    //   [0] packed RGBA8 color (alpha always opaque)
    //   [1] the hit's TOTAL path length as float bits (DIST_SKY on a
    //       miss) - the upscaler's primary edge signal; for a wormhole-
    //       mediated hit it INCLUDES the 4D throat path, so opposite sides
    //       of the mouth separate in the depth gate for free
    //   [2] 3x8-bit world normal ([-1,1] -> [0,255]) | 8-bit family id in
    //       the top byte (0 = sky, 1 = plane, 2 = terrain; = family + 1).
    //       A wormhole-mediated hit reports the FINAL VISIBLE surface's
    //       normal/id - no special "through-wormhole" class needed yet.
    // NOTE: the local name must not be 'packed' - it is a reserved GLSL keyword.
    int stride = (pix.x + pix.y * int(Resolution.x)) * 3;

    uint packedPx = (uint(color.r * 255.0 + 0.5))
                | (uint(color.g * 255.0 + 0.5) << 8)
                | (uint(color.b * 255.0 + 0.5) << 16)
                | 0xFF000000u;

    vec3 ne = nrm * 0.5 + 0.5;    // sky: nrm = (0,0,0) -> mid-gray marker
    uint normPack = uint(clamp(ne.x * 255.0 + 0.5, 0.0, 255.0))
                 | (uint(clamp(ne.y * 255.0 + 0.5, 0.0, 255.0)) << 8)
                 | (uint(clamp(ne.z * 255.0 + 0.5, 0.0, 255.0)) << 16)
                 | ((hit ? uint(clamp(float(family) + 1.0, 0.0, 255.0)) : 0u) << 24);

    pixelBuf.data[stride + 0] = packedPx;
    pixelBuf.data[stride + 1] = floatBitsToUint(hit ? t : DIST_SKY);
    pixelBuf.data[stride + 2] = normPack;
}
