// Compute stage: raymarches the scene for EVERY pixel in parallel (one work
// item per pixel) and writes one packed RGBA8 uint per pixel into the shared
// pixel buffer (SSBO, binding 0). The display stage (RaymarcherDisplay.fs)
// then blits that buffer to the screen, so the fragment pipeline only
// performs a 1:1 buffer read.
//
// This file is the raymarcher's DRIVER. It owns the per-pixel ray, the
// camera/ray uniforms, the output buffer and the overall flow:
//
//     pixel -> Ray -> IntersectScene (closest hit) -> shade -> pack -> SSBO
//
// Scene pieces are NOT in this file - they are included, self-contained,
// and follow the contract documented in Raymarcher/Shapes/Plane.inc:
//
//     #include "Raymarcher/Shapes/Plane.inc"   plane shape family
//     #include "Raymarcher/Shapes/Terrain.inc" infinite FBM heightfield terrain
//     #include "Raymarcher/Shapes/Wormhole.inc" wormhole: event horizon + bent light
//     #include "Raymarcher/Sky.inc"            sky / horizon atmosphere
//
// ADDING A FEATURE (the include contract):
//   - Shape family: add Raymarcher/Shapes/<Name>.inc declaring its family ID
//     (const int Family<Name> = N; - next free number), its data, uniforms,
//     Intersect<Name>(...) and Shade<Name>(...), then extend IntersectScene()
//     to race it against the other families and the shading dispatch in main().
//   - Raytraced reflections: march a SECOND ray through IntersectScene()
//     in the shading step (e.g. reflect(ray.Dir, <hit normal>)), and mix
//     its color into the surface color.
//   - 4D objects / non-Euclidean geometry: extend the Ray struct and bend
//     ray.Dir between IntersectScene() steps (or transform the shape data);
//     the driver flow above is the only code that changes.
//   - Atmosphere/background: extend Raymarcher/Sky.inc.
//
// NOTES:
//   - #version 430 is required for compute shaders (dispatch, SSBOs,
//     layout(local_size...)) and must stay the first line: Resource.LoadShader
//     expands the #include directives IN PLACE below it (included files must
//     never carry a #version of their own).
//   - PlaneTex is sampled from texture unit 0: the C# side binds the texture
//     there before dispatching and sets the sampler uniform to 0.
//     Raylib.SetShaderValueTexture must NOT be used for the compute stage -
//     it defers the real glBindTexture to the batch draw, which happens
//     AFTER the dispatch.
#version 430

#include "Raymarcher/Shapes/Plane.inc"
#include "Raymarcher/Shapes/Terrain.inc"
#include "Raymarcher/Shapes/Wormhole.inc"
#include "Raymarcher/Sky.inc"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// ---------------------------------------------------------------------------
// Driver state
// ---------------------------------------------------------------------------

// The per-pixel ray, shared by every shape/atmosphere include. Kept as a
// struct so future includes (reflections, 4D rays) work with one stable type.
struct Ray
{
    vec3 Origin;    // world space
    vec3 Dir;       // world space, normalized
};

uniform vec2  Resolution;            // framebuffer size in pixels
uniform mat4  CamToWorld;            // camera space (y up, -z forward) -> world
uniform float Focal;                 // 1 / tan(fovY * 0.5), precomputed in C#

// One packed RGBA8 uint per screen pixel, shared with the display stage
// (std430 uint array: 4-byte stride, no padding).
layout(std430, binding = 0) buffer Pixels
{
    uint data[];
} pixelBuf;

// ---------------------------------------------------------------------------
// Ray generation
// ---------------------------------------------------------------------------

// World-space primary ray through the center of the given pixel.
Ray MakePixelRay(vec2 pixel)
{
    // Pixel center in normalized device coords (y up, -1..1, x aspect-corrected).
    vec2 ndc = (2.0 * pixel - Resolution) / Resolution.y;

    // Pixel ray in camera space, then world space.
    vec3 dirCam = normalize(vec3(ndc, -Focal));
    return Ray(
        (CamToWorld * vec4(0.0, 0.0, 0.0, 1.0)).xyz,
        normalize((CamToWorld * vec4(dirCam, 0.0)).xyz));
}

// ---------------------------------------------------------------------------
// Scene intersection: closest hit across ALL shape families
// ---------------------------------------------------------------------------

// Races every included shape family and keeps the closest hit. Returns true
// on hit, with the hit distance t, the winner's family-space uv and the
// winner's family ID (Family<Name>, declared in each shape's .inc) latched.
//
// Each family block must follow the plane pattern below: an
// Intersect<Family>() that returns -1 on miss and only latches its uv when
// t improves (a farther hit later in the block must never clobber the
// closest hit's uv).
bool IntersectScene(Ray ray, out vec2 uv, out float t, out int family)
{
    t      = -1.0;
    uv     = vec2(0.0);
    family = -1;

    // --- Plane family ---
    for (int i = 0; i < MAX_PLANES; i++)
    {
        if (i >= PlaneCount) break;
        vec2 candUv;
        float th = IntersectPlane(ray.Origin, ray.Dir, i, candUv);
        if (th > 0.0 && (t < 0.0 || th < t)) { t = th; uv = candUv; family = FamilyPlane; }
    }

    // --- Terrain family ---
    if (TerrainEnabled > 0)
    {
        vec2 candUv;
        float th = IntersectTerrain(ray.Origin, ray.Dir, candUv);
        if (th > 0.0 && (t < 0.0 || th < t)) { t = th; uv = candUv; family = FamilyTerrain; }
    }

    // --- Wormhole family (event horizon sphere) ---
    if (WormholeEnabled > 0)
    {
        vec2 candUv;
        float th = IntersectWormhole(ray.Origin, ray.Dir, candUv);
        if (th > 0.0 && (t < 0.0 || th < t)) { t = th; uv = candUv; family = FamilyWormhole; }
    }

    return t > 0.0;
}

// ---------------------------------------------------------------------------
// Shading helpers
// ---------------------------------------------------------------------------

// Gentle exponential distance fog toward the horizon (fog color from
// Sky.inc, fogged direction kept horizontal so the gradient stays stable).
vec3 ApplyFog(vec3 color, float dist, vec3 dir)
{
    vec3 fogColor = SkyColor(normalize(vec3(dir.x, 0.0, dir.z)));
    float fog = 1.0 - exp(-0.010 * dist);
    return mix(color, fogColor, fog);
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);

    // The dispatch grid is rounded up to whole workgroups; ignore the tail.
    if (pix.x >= int(Resolution.x) || pix.y >= int(Resolution.y)) return;

    Ray ray = MakePixelRay(vec2(pix));

    // Closest scene hit (uv and family belong to the winning family).
    // t is the TOTAL path length of the ray (straight or bent) so fog
    // matches what the light actually travelled; skyDir is the final ray
    // direction (bent rays exit the field angled).
    vec2 uv = vec2(0.0);
    float t = 0.0;
    int family = -1;
    vec3 skyDir = ray.Dir;
    vec3 hitPos = ray.Origin;
    bool hit = false;

    if (WormholeEnabled > 0 && RayBendsAroundWormhole(ray.Origin, ray.Dir))
    {
        // ------------------------------------------------------------------
        // Bent-ray trace: the "non-Euclidean" extension point of the driver
        // header - Dir is bent between steps (see Wormhole.inc for the
        // field physics). Only rays passing within WORMHOLE_BEND_RADIUS of
        // the mouth enter this path; the rest of the screen stays on the
        // exact analytic trace below.
        //
        // COST MODEL (why the loop is structured this way): the terrain
        // family is a FBM heightfield march - the most expensive thing in
        // this shader - so a full IntersectScene() is NOT run per bend
        // step. Per step we test only the cheap analytic pieces:
        //   - horizon capture (r <= Rs, plus exact sphere entry in the
        //     step),
        //   - planes (analytic, bounded by MAX_PLANES),
        //   - terrain, but only when the step segment can even reach the
        //     terrain's ceiling plane (y = terrainTop), which requires
        //     dir.y < 0 and the plane crossing within dt - and that march
        //     is CACHED: a surface point found ahead of the ray is
        //     remembered and re-verified cheaply (along-ray distance +
        //     perpendicular offset) instead of re-marched every step.
        // The full IntersectScene() runs exactly once, when the ray
        // escapes the field or the step budget is exhausted - the scene
        // is static, so no surface can "move into" the ray mid-field.
        // ------------------------------------------------------------------
        vec3 pos = ray.Origin;
        vec3 dir = ray.Dir;
        float pathLen = WormholeBendPreflight(ray.Origin, ray.Dir, pos);

        // Cached terrain hit for the per-step check below (see the terrain
        // section of the loop for the re-verification logic).
        vec3 terrainHitPos  = vec3(0.0);
        vec2 terrainHitUv   = vec2(0.0);
        bool haveTerrainHit = false;

        // The terrain's global maximum (Offset.y + Amplitude; the true max
        // is slightly lower because Fbm < 1 and HillShape < 1). Same
        // bound IntersectTerrain() uses for its direction cull.
        float terrainTop = (TerrainEnabled > 0)
                           ? TerrainData[0].y + TerrainData[1].x
                           : -1e20;

        for (int i = 0; i < WORMHOLE_MAX_BEND_STEPS && !hit; i++)
        {
            vec3  dc = pos - WormholeCenter();
            float r  = length(dc);

            // Captured by the event horizon (camera already inside, or a
            // spiral crossed it between steps): black disc (ShadeWormhole
            // adds the photon-ring rim).
            if (r <= WormholeRadius())
            {
                family = FamilyWormhole;
                uv     = vec2(0.0);
                t      = pathLen;
                hitPos = pos;
                hit    = true;
                break;
            }

            // Adaptive step: dt = 0.1 * r is a constant ANGLE (0.1 rad of
            // arc) at any radius - fine enough at the throat for orbit
            // fidelity, and 1.0 world units far out where the field is
            // weak, so a full crossing of the field costs ~30 steps
            // instead of ~150. Capture is exact anyway (analytic sphere
            // test below), so the floor can be coarse.
            float dt = clamp(0.1 * r, 0.1, 1.0);

            // Exact horizon entry within this step (analytic, cheap).
            vec2  tuv;
            float th = IntersectWormhole(pos, dir, tuv);
            if (th > 0.0 && th <= dt)
            {
                family = FamilyWormhole;
                uv     = vec2(0.0);
                t      = pathLen + th;
                hitPos = pos + dir * th;
                skyDir = dir;
                hit    = true;
                break;
            }

            // Planes (analytic, cheap): consume any hit within this step.
            for (int p = 0; p < MAX_PLANES; p++)
            {
                if (p >= PlaneCount) break;
                vec2 pu;
                float ph = IntersectPlane(pos, dir, p, pu);
                if (ph > 0.0 && ph <= dt)
                {
                    family = FamilyPlane;
                    uv     = pu;
                    t      = pathLen + ph;
                    hitPos = pos + dir * ph;
                    skyDir = dir;
                    hit    = true;
                    break;
                }
            }
            if (hit) break;

            // Terrain: march the heightfield only when the step segment
            // can reach the surface. The surface never rises above
            // terrainTop, so a hit within [0, dt] requires the segment to
            // cross the plane y = terrainTop within the step (or start
            // below it, where a hit can't be ruled out cheaply).
            //
            // The march is the most expensive call in this loop, so its
            // result is cached: once it finds a surface point ahead of the
            // ray, later steps only verify the (slowly bending) ray still
            // passes through that remembered point and re-march only when
            // it no longer does.
            if (TerrainEnabled > 0 && dir.y < 0.0)
            {
                if (pos.y < terrainTop || (pos.y - terrainTop) <= -dir.y * dt)
                {
                    vec2  ttuv = terrainHitUv;
                    float tth  = -1.0;
                    if (haveTerrainHit)
                    {
                        // Cheap re-verification of the cached surface point:
                        // it is still the hit iff the ray passes within
                        // tolerance of it (tolerance grows with distance:
                        // a few degrees of accumulated bend + march epsilon).
                        vec3  v    = terrainHitPos - pos;
                        float s    = dot(v, dir);
                        float perp = length(cross(dir, v));
                        if (s > 0.0 && perp <= 0.10 + 0.05 * s)
                            tth = s;
                    }
                    if (tth < 0.0)
                    {
                        // No valid cache: full march; remember the result.
                        tth = IntersectTerrain(pos, dir, ttuv);
                        haveTerrainHit = tth > 0.0;
                        if (haveTerrainHit)
                        {
                            terrainHitPos = pos + dir * tth;
                            terrainHitUv  = ttuv;
                        }
                    }
                    if (tth > 0.0 && tth <= dt)
                    {
                        family = FamilyTerrain;
                        uv     = ttuv;
                        t      = pathLen + tth;
                        hitPos = pos + dir * tth;
                        skyDir = dir;
                        hit    = true;
                        break;
                    }
                }
            }

            pos += dir * dt;
            pathLen += dt;

            // Newtonian photon deflection with mu = Rs: a = -Rs * d / r^3.
            // Reproduces the GR point-mass deflection angle delta = 2 Rs / b
            // (see Wormhole.inc for the derivation).
            float r2 = dot(dc, dc);
            dir = normalize(dir - WormholeRadius() * dc / (r2 * r) * dt);

            // Escaped the field and moving away: take over with the exact
            // straight trace (bending is negligible beyond the field).
            vec3 d2 = pos - WormholeCenter();
            if (dot(d2, d2) > WormholeBendRadius2() && dot(dir, d2) > 0.0)
            {
                vec2  tu2;
                float th2;
                int   tf2;
                if (IntersectScene(Ray(pos, dir), tu2, th2, tf2))
                {
                    family = tf2;
                    uv     = tu2;
                    t      = pathLen + th2;
                    hitPos = pos + dir * th2;
                    hit    = true;
                }
                skyDir = dir;
                break;
            }
        }

        if (!hit)
        {
            // Step budget exhausted (deep orbit): exact straight tail.
            vec2  tu;
            float th;
            int   tf;
            if (IntersectScene(Ray(pos, dir), tu, th, tf))
            {
                family = tf;
                uv     = tu;
                t      = pathLen + th;
                hitPos = pos + dir * th;
                hit    = true;
            }
            skyDir = dir;
        }
    }
    else
    {
        hit = IntersectScene(ray, uv, t, family);
        if (hit) hitPos = ray.Origin + ray.Dir * t;
    }

    vec3 color;
    if (hit)
    {
        // Dispatch shading to the family that won the race (each shape's
        // .inc declares its own shade function; extend the dispatch when
        // adding a family).
        color = (family == FamilyTerrain)
                ? ShadeTerrain(uv)
              : (family == FamilyWormhole)
                ? ShadeWormhole(normalize(hitPos - WormholeCenter()), skyDir)
                : ShadePlane(uv);

        // The horizon is "eternally black" - don't wash it with distance fog.
        if (family != FamilyWormhole)
            color = ApplyFog(color, t, skyDir);
    }
    else
    {
        color = SkyColor(skyDir);
    }

    // Pack RGBA8 into one uint (alpha always opaque).
    // NOTE: the local name must not be 'packed' - it is a reserved GLSL keyword.
    uint packedPx = (uint(color.r * 255.0 + 0.5))
                | (uint(color.g * 255.0 + 0.5) << 8)
                | (uint(color.b * 255.0 + 0.5) << 16)
                | 0xFF000000u;

    pixelBuf.data[pix.x + pix.y * int(Resolution.x)] = packedPx;
}
